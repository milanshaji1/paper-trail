# ─────────────────────────────────────────────────────────────
#  PaperTrail — optional API keys (ALL FREE, ALL OPTIONAL)
#  The dashboard works fully with NO keys. Adding these unlocks
#  higher-accuracy data. To use: copy this file to ".env" (no ext),
#  paste your key(s), and restart the app.
# ─────────────────────────────────────────────────────────────

# Finnhub — REAL analyst consensus + price targets + real-time quotes.
# Biggest accuracy upgrade. Free tier is generous.
# Get a key (30 seconds, no card): https://finnhub.io/register
FINNHUB_API_KEY=

# FRED (US Federal Reserve economic data) — real macro series
# (CPI, rates, unemployment). Free.
# Get a key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# CoinGecko demo key — higher crypto rate limits / fresher updates. Free.
# Get a key: https://www.coingecko.com/en/developers/dashboard
COINGECKO_DEMO_KEY=
