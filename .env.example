# ─────────────────────────────────────────────────────────────
#  PaperTrail — optional API keys (ALL FREE, ALL OPTIONAL)
#  The dashboard works fully with NO keys. Adding these unlocks
#  higher-accuracy data. To use: copy this file to ".env" (no ext),
#  paste your key(s), and restart the app.
# ─────────────────────────────────────────────────────────────

# Finnhub — REAL analyst consensus + price targets + real-time quotes.
# Biggest accuracy upgrade. Free tier is generous.
# Get a key (30 seconds, no card): https://finnhub.io/register
FINNHUB_API_KEY=

# FRED (US Federal Reserve economic data) — real macro series
# (CPI, rates, unemployment). Free.
# Get a key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# CoinGecko demo key — higher crypto rate limits / fresher updates. Free.
# Get a key: https://www.coingecko.com/en/developers/dashboard
COINGECKO_DEMO_KEY=

# ─────────────────────────────────────────────────────────────
#  Watchers — DJT Watch + Meme Radar
#
#  Every DATA source is free and keyless (Truth Social via the CNN
#  mirror, whitehouse.gov, Federal Register, GeckoTerminal,
#  DexScreener, RugCheck, GoPlus). The only credentials here are for
#  DELIVERING alerts to your phone. Without them both watchers still
#  run, score and publish to the dashboard — they just stay silent.
# ─────────────────────────────────────────────────────────────

# Telegram — how alerts reach your phone.
#   1. Message @BotFather on Telegram, send /newbot, follow the prompts.
#   2. Paste the token it gives you below.
#   3. Message your new bot once (it can't message you first), then open
#      https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates and copy
#      the "chat":{"id": ...} number into TELEGRAM_CHAT_ID.
# For the 24/7 cloud watcher, set these as GitHub repo secrets instead:
#   Settings → Secrets and variables → Actions → New repository secret
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Tuning (all optional, sensible defaults) ──

# Alert threshold for Trump posts, 0-100. Default 40 ≈ 1 alert/day.
# The score distribution is bimodal with a gap at 30-39, so anything in
# that range behaves identically. Below ~25 you start getting Daylight
# Saving Time opinions. Calibrate with: node scripts/djt-calibrate.js
# DJT_BAND_MEDIUM=40

# Ignore feed items older than this many hours (default 48). Stops a
# state loss from replaying three-week-old proclamations as new.
# DJT_MAX_AGE_H=48

# Memecoin safety gate. Loosening these is how a radar becomes a rug feed.
# MEME_MIN_LIQ=15000      # minimum pool liquidity, USD
# MEME_MAX_TOP10=60       # max % held by the top 10 wallets
# MEME_MIN_HOLDERS=50     # minimum holder count
# MEME_MAX_RISK=40        # max RugCheck risk score (0 = safest)
# MEME_MAX_TAX=10         # max buy/sell tax %, EVM chains
# MEME_NETWORKS=solana,base
# MEME_COOLDOWN_H=12      # don't re-alert the same token within N hours
